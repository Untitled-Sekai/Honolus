  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@sonolus/core": "^7.15.3",
    "@untitledsekai/honolus": "file:.."
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
