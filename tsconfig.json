{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,  /* デコレーターを使うために必須 */
    "emitDecoratorMetadata": true,   /* メタデータが必要な場合用 */
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}